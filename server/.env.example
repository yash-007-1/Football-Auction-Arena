# Copy to server/.env (or set real environment variables in production).
PORT=3001
NODE_ENV=development
# SQLite file (created automatically). See README for the PostgreSQL migration path.
DATABASE_PATH=./data/football-auction.db
# Origin allowed by CORS in development (Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
# Production: directory of the built client that the server should serve.
CLIENT_DIST=../client/dist
LOG_LEVEL=info
MAX_ROOMS=500
ROOM_IDLE_DAYS=14
SOCKET_RATE_PER_SEC=15
REST_RATE_WINDOW_MS=60000
REST_RATE_MAX=40
